# Normalise line endings so a checkout on another machine does not show every
# file as fully rewritten.
* text=auto

# Tools that are picky about CRLF on Windows.
*.sln   text eol=crlf
*.slnx  text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.ps1   text eol=crlf

# Never touch binaries.
*.dll binary
*.exe binary
*.ico binary
*.png binary
*.pdb binary
