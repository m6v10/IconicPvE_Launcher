  "news": [
    {
      "id": "launcher-105",
      "date": "2026-08-07",
      "title": "Launcher v1.0.5",
      "body": "Your server list is yours now. ADD SERVER puts any DayZ server in the launcher by IP and port, and EDIT SERVER LIST lets you switch off the ones you do not play on. A server you switch off is no longer checked, so its mods stop asking to be updated. (So that you dont get pushed to update test mods etc.)",
      "url": null
    },
    {
      "id": "v105",
      "date": "2026-08-07",
      "title": "Minor Update",
      "body": "Tripled Demonlord Hard's lootpool. Lite servers drop this new buffed lootpool twice. Fixed a few instabilities backend and fixed a possible server-crash issue. New Update coming soon.",
      "url": null
    },
    {
      "id": "v104",
      "date": "2026-08-03",
      "title": "Launcher v1.0.4",
      "body": "Added debug settings and logging tools, compact server cards with sort arrows, navigation moved to the top bar, NEW badge on fresh news.",
      "url": null
    },
    {
      "id": "v103",
      "date": "02.08.2026",
      "title": "Launcher v1.0.3",
      "body": "News now refreshes on its own while the launcher is open, so announcements show up without restarting it.",
