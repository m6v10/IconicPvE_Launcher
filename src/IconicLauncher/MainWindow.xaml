<Window x:Class="IconicLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:IconicLauncher.ViewModels"
        xmlns:views="clr-namespace:IconicLauncher.Views"
        Title="Iconic PvE Launcher"
        Icon="Assets/icon.ico"
        Width="1120" Height="720" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
            <views:ProfileView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModsViewModel}">
            <views:ModsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminViewModel}">
            <views:AdminView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WowViewModel}">
            <views:WowHomeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WowAddonsViewModel}">
            <views:WowAddonsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AddServerDialogViewModel}">
            <views:AddServerDialog/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EditServersDialogViewModel}">
            <views:EditServersDialog/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GraphicsWarningDialogViewModel}">
            <views:GraphicsWarningDialog/>
        </DataTemplate>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseDialogCommand}"/>
    </Window.InputBindings>
    <Grid>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid Height="60">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Width="160" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="ICONIC" FontSize="22" FontWeight="Black" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{Binding GameSuffixText}" FontSize="22" FontWeight="Black">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource HotBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWowActive}" Value="True">
                                            <Setter Property="Foreground" Value="#69CCF0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="26,0,0,0">
                    <RadioButton Style="{StaticResource NavItemTop}" GroupName="Nav" Content="HOME"
                                 IsChecked="{Binding IsHomeChecked, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="HOME"/>
                    <RadioButton Style="{StaticResource NavItemTop}" GroupName="Nav" Content="PROFILE" Command="{Binding NavigateCommand}" CommandParameter="PROFILE"
                                 IsChecked="{Binding IsProfileChecked, Mode=OneWay}"
                                 Visibility="{Binding IsDayZActive, Converter={StaticResource BoolToVis}}"/>
                    <RadioButton Style="{StaticResource NavItemTop}" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="MODS"
                                 IsChecked="{Binding IsModsChecked, Mode=OneWay}"
                                 Visibility="{Binding IsDayZActive, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="MODS" VerticalAlignment="Center"/>
                            <Border Margin="8,0,0,0" Padding="7,1" CornerRadius="8" VerticalAlignment="Center"
                                    Background="{StaticResource StatusAmberBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Mods.HasAnyNeedsUpdate}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="ModsBadgePulse">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.4"
                                                                             Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="ModsBadgePulse"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Mods.NeedsUpdateCount}" FontSize="10" FontWeight="Bold" Foreground="#1A1A1A"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItemTop}" GroupName="Nav" Content="ADD-ONS" Command="{Binding NavigateCommand}" CommandParameter="ADDONS"
                                 IsChecked="{Binding IsAddonsChecked, Mode=OneWay}"
                                 Visibility="{Binding IsWowActive, Converter={StaticResource BoolToVis}}"/>
                    <RadioButton Style="{StaticResource NavItemTop}" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="SETTINGS"
                                 IsChecked="{Binding IsSettingsChecked, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SETTINGS"/>
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource StatusAmberBrush}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                       ToolTip="Your DayZ graphics are above Medium. DayZ 1.30 can crash on High or Extreme - click to see.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding SettingsPage.GraphicsAlert}" Value="True"/>
                                                    <Condition Binding="{Binding IsDayZActive}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="GraphicsAlertBlink">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.15"
                                                                             Duration="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="GraphicsAlertBlink"/>
                                                </MultiDataTrigger.ExitActions>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource StatusRedBrush}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding SettingsPage.IsProfileNameSuspicious, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItemTop}" GroupName="Nav" Content="ADMIN" Command="{Binding NavigateCommand}" CommandParameter="ADMIN"
                                 IsChecked="{Binding IsAdminChecked, Mode=OneWay}"
                                 Visibility="{Binding IsAdminMode, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Border Margin="0,0,14,0" VerticalAlignment="Center" Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource GameSwitchItem}" GroupName="Game" ToolTip="Switch to DayZ"
                                         IsChecked="{Binding IsDayZActive, Mode=OneWay}"
                                         Command="{Binding SwitchGameCommand}" CommandParameter="DAYZ">
                                <Image Source="/Assets/dayz_logo.png" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </RadioButton>
                            <RadioButton Style="{StaticResource GameSwitchItem}" GroupName="Game" ToolTip="Switch to WoW"
                                         IsChecked="{Binding IsWowActive, Mode=OneWay}"
                                         Command="{Binding SwitchGameCommand}" CommandParameter="WOW">
                                <Image Source="/Assets/wow_logo.png" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                    <Button Command="{Binding RunSelfUpdateCommand}" Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource StatusGreenButton}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="UpdateButtonPulse">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.45"
                                                                     Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="UpdateButtonPulse"/>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="UPDATE" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenWebsiteCommand}" Margin="0,0,10,0"
                            Visibility="{Binding WebsiteUrl, Converter={StaticResource NullToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="WEBSITE" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="DISCORD" Command="{Binding OpenDiscordCommand}"/>
                </StackPanel>
                <TextBlock Grid.Column="4" Text="{Binding VersionLabel}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Top" Background="{DynamicResource AccentTintBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="20,10"
                Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding UpdateBannerText}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AccentSoftBrush}"/>
                <Button Content="DOWNLOAD + RESTART" Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="16,0,0,0" Command="{Binding RunSelfUpdateCommand}"/>
                <ProgressBar Width="180" Height="8" Margin="16,0,0,0" VerticalAlignment="Center" Maximum="100" Value="{Binding UpdateProgress, Mode=OneWay}"
                             Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface2Brush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="20,8"
                Visibility="{Binding StatusBanner, Converter={StaticResource NullToVis}}">
            <TextBlock Text="{Binding StatusBanner}" Foreground="{StaticResource StatusAmberBrush}" FontSize="12" TextWrapping="Wrap"/>
        </Border>
        <Grid>
            <Grid x:Name="DayZBackdrop" ClipToBounds="True" IsVisibleChanged="OnBackdropVisibleChanged"
                  Visibility="{Binding ShowDayZBackdrop, Converter={StaticResource BoolToVis}}">
                <Rectangle>
                    <Rectangle.Fill>
                        <VisualBrush Visual="{Binding ElementName=HeroFrame}" Stretch="UniformToFill"/>
                    </Rectangle.Fill>
                    <Rectangle.Effect>
                        <BlurEffect Radius="70" RenderingBias="Performance"/>
                    </Rectangle.Effect>
                </Rectangle>
                <Rectangle Fill="#660F1115"/>
                <Viewbox Stretch="Uniform" Margin="28,84,344,142">
                    <Viewbox.Style>
                        <Style TargetType="Viewbox">
                            <Setter Property="Opacity" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProfilePage}" Value="True">
                                    <Setter Property="Opacity" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Viewbox.Style>
                    <Viewbox.OpacityMask>
                        <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#FF000000" Offset="0"/>
                            <GradientStop Color="#F2000000" Offset="0.42"/>
                            <GradientStop Color="#8C000000" Offset="0.72"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Viewbox.OpacityMask>
                    <Grid x:Name="HeroFrame" Width="1280" Height="574">
                        <Image Source="/Assets/dayz_hero.jpg" Stretch="Fill"/>
                        <MediaElement x:Name="DayZVideo" Source="{Binding DayZHeroVideoUri}" Stretch="Fill"
                                      LoadedBehavior="Manual" UnloadedBehavior="Manual" IsMuted="True"
                                      Loaded="OnDayZVideoLoaded" MediaOpened="OnDayZVideoLoaded"
                                      MediaEnded="OnDayZVideoEnded" MediaFailed="OnDayZVideoFailed"
                                      Visibility="{Binding DayZHeroVideoUri, Converter={StaticResource NullToVis}}"/>
                    </Grid>
                </Viewbox>
                <Grid Visibility="{Binding IsProfilePage, Converter={StaticResource InvBoolToVis}}">
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#800F1115" Offset="0"/>
                                <GradientStop Color="#000F1115" Offset="0.2"/>
                                <GradientStop Color="#000F1115" Offset="0.62"/>
                                <GradientStop Color="#E60F1115" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#000F1115" Offset="0.6"/>
                                <GradientStop Color="#B30F1115" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>
                <Rectangle Fill="#C70D0F13" Visibility="{Binding IsProfilePage, Converter={StaticResource BoolToVis}}"/>
            </Grid>
            <ContentControl Content="{Binding CurrentViewModel}"/>
        </Grid>
    </DockPanel>
    <Border Background="#C0070809" Visibility="{Binding Dialog, Converter={StaticResource NullToVis}}">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Dialog, Converter={StaticResource NullToVis}}" Value="Visible">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <ContentControl Content="{Binding Dialog}" Margin="24"/>
    </Border>
    </Grid>
</Window>
