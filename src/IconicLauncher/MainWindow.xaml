<Window x:Class="IconicLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:IconicLauncher.ViewModels"
        xmlns:views="clr-namespace:IconicLauncher.Views"
        Title="Iconic PvE Launcher"
        Icon="Assets/icon.ico"
        Width="1120" Height="720" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModsViewModel}">
            <views:ModsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminViewModel}">
            <views:AdminView/>
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid Height="60">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ICONIC" FontSize="22" FontWeight="Black" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text=" PvE" FontSize="22" FontWeight="Black" Foreground="{StaticResource HotBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Button Command="{Binding OpenWebsiteCommand}" Margin="0,0,10,0"
                            Visibility="{Binding WebsiteUrl, Converter={StaticResource NullToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="WEBSITE" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RunSelfUpdateCommand}" Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource StatusGreenButton}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="UpdateButtonPulse">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.45"
                                                                     Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="UpdateButtonPulse"/>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="UPDATE" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="DISCORD" Command="{Binding OpenDiscordCommand}"/>
                </StackPanel>
                <TextBlock Grid.Column="4" Text="{Binding VersionLabel}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Top" Background="{StaticResource AccentTintBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="20,10"
                Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding UpdateBannerText}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource AccentSoftBrush}"/>
                <Button Content="DOWNLOAD + RESTART" Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="16,0,0,0" Command="{Binding RunSelfUpdateCommand}"/>
                <ProgressBar Width="180" Height="8" Margin="16,0,0,0" VerticalAlignment="Center" Maximum="100" Value="{Binding UpdateProgress, Mode=OneWay}"
                             Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="20,8"
                Visibility="{Binding StatusBanner, Converter={StaticResource NullToVis}}">
            <TextBlock Text="{Binding StatusBanner}" Foreground="{StaticResource StatusAmberBrush}" FontSize="12" TextWrapping="Wrap"/>
        </Border>
        <Border DockPanel.Dock="Left" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,1,0" Width="180">
            <StackPanel Margin="0,18,0,0">
                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Content="HOME" IsChecked="True" Command="{Binding NavigateCommand}" CommandParameter="HOME"/>
                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="MODS">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="MODS" VerticalAlignment="Center"/>
                        <Border Margin="8,0,0,0" Padding="7,1" CornerRadius="8" VerticalAlignment="Center"
                                Background="{StaticResource StatusAmberBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Mods.HasAnyNeedsUpdate}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="ModsBadgePulse">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.4"
                                                                         Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="ModsBadgePulse"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Mods.NeedsUpdateCount}" FontSize="10" FontWeight="Bold" Foreground="#1A1A1A"/>
                        </Border>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="SETTINGS">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SETTINGS"/>
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource StatusRedBrush}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding SettingsPage.IsProfileNameSuspicious, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Content="ADMIN" Command="{Binding NavigateCommand}" CommandParameter="ADMIN"
                             Visibility="{Binding IsAdminMode, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>
        <ContentControl Content="{Binding CurrentViewModel}"/>
    </DockPanel>
</Window>
