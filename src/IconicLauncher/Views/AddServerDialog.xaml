<UserControl x:Class="IconicLauncher.Views.AddServerDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Center" VerticalAlignment="Center">
    <Border Style="{StaticResource DialogCard}" Width="560">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource AccentTintBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0" Padding="22,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="ADD A SERVER" Style="{StaticResource DialogTitle}"/>
                        <TextBlock Text="Any DayZ server, not just Iconic PvE. Its mods are read straight from the server."
                                   FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Close"
                            VerticalAlignment="Top" Command="{Binding CancelCommand}"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="22,18,22,4">
                <TextBlock Text="SERVER IP" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" FontSize="13"/>
                <TextBlock Text="Paste 193.25.252.68:2302 and the ports below fill in for you."
                           FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="2,5,0,0"/>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="GAME PORT" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding GamePortText, UpdateSourceTrigger=PropertyChanged}" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="QUERY PORT" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding QueryPortText, UpdateSourceTrigger=PropertyChanged}" FontSize="13"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="DISPLAY NAME (OPTIONAL)" Style="{StaticResource FieldLabel}" Margin="0,14,0,5"/>
                <TextBox Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}" FontSize="13"/>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Command="{Binding TestConnectionCommand}" Padding="14,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="TEST CONNECTION" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Optional, but it fills in the name and proves the ports are right."
                               FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="290"/>
                </StackPanel>

                <Border Margin="0,14,0,0" CornerRadius="6" BorderThickness="1" Padding="12,10"
                        Visibility="{Binding ProbeText, Converter={StaticResource NullToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ProbeOk}" Value="True">
                                    <Setter Property="Background" Value="#1F4CAF50"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource StatusGreenBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ProbeFailed}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource RowAlertBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource StatusRedBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Top" Margin="0,1,10,0" Text="&#xE9F5;">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ProbeOk}" Value="True">
                                            <Setter Property="Text" Value="&#xE73E;"/>
                                            <Setter Property="Foreground" Value="{StaticResource StatusGreenBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ProbeFailed}" Value="True">
                                            <Setter Property="Text" Value="&#xE7BA;"/>
                                            <Setter Property="Foreground" Value="{StaticResource AlertTextBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding ProbeText}" FontSize="12" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" MaxWidth="450"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding ErrorText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AlertTextBrush}"
                           TextWrapping="Wrap" Margin="0,12,0,0"
                           Visibility="{Binding ErrorText, Converter={StaticResource NullToVis}}"/>
            </StackPanel>

            <Border Grid.Row="2" Background="{StaticResource BgBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12" Padding="22,14" Margin="0,18,0,0">
                <Grid>
                    <TextBlock Text="Mods are pulled from this server every time you join." FontSize="10"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="270"
                               HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="CANCEL" Padding="16,8" Command="{Binding CancelCommand}"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="ADD SERVER" Padding="20,8" Margin="10,0,0,0"
                                Command="{Binding AddCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
