<UserControl x:Class="IconicLauncher.Views.EditServersDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Center" VerticalAlignment="Center">
    <Border Style="{StaticResource DialogCard}" Width="620">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource AccentTintBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0" Padding="22,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="YOUR SERVER LIST" Style="{StaticResource DialogTitle}"/>
                        <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"
                                   Text="Switch a server off and the launcher stops checking and downloading its mods."/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Close"
                            VerticalAlignment="Top" Command="{Binding CloseCommand}"/>
                </Grid>
            </Border>

            <TextBlock Grid.Row="1" Text="{Binding HeaderText}" Style="{StaticResource SectionLabel}" Margin="22,14,22,4"/>

            <ScrollViewer Grid.Row="2" MaxHeight="360" VerticalScrollBarVisibility="Auto" Margin="14,0,10,0">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" BorderThickness="1" Padding="14,11" Margin="8,0,8,8"
                                    Background="{StaticResource Surface2Brush}" BorderBrush="{DynamicResource HairlineBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Opacity" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsShown}" Value="False">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsShown, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="0,0,14,0"
                                              ToolTip="Show or hide this server in the launcher"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource HotBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding Address}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock Text="&#160;&#183;&#160;" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock Text="{Binding ModsLabel}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource Badge}" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding SourceLabel}" FontSize="9" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCustom}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource StatusGreenBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <Button Grid.Column="3" Style="{StaticResource DangerIconButton}" Content="&#xE74D;"
                                            ToolTip="Delete this server" VerticalAlignment="Center" Margin="10,0,0,0"
                                            Command="{Binding DeleteCommand}"
                                            Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="3" Text="{Binding ErrorText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AlertTextBrush}"
                       TextWrapping="Wrap" Margin="22,4,22,0"
                       Visibility="{Binding ErrorText, Converter={StaticResource NullToVis}}"/>

            <Border Grid.Row="4" Background="{StaticResource BgBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12" Padding="22,14" Margin="0,14,0,0">
                <Grid>
                    <Button HorizontalAlignment="Left" Padding="14,8" Command="{Binding RestoreDefaultsCommand}"
                            ToolTip="Show every Iconic PvE server again">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="RESTORE DEFAULTS" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Padding="14,8" Command="{Binding AddServerCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="ADD SERVER" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Content="DONE" Padding="24,8" Margin="10,0,0,0"
                                Command="{Binding CloseCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
