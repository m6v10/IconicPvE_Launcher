<UserControl x:Class="IconicLauncher.Views.GraphicsWarningDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Center" VerticalAlignment="Center">
    <Border Style="{StaticResource DialogCard}" Width="560">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource AccentTintBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0" Padding="22,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource StatusAmberBrush}"
                               VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource DialogTitle}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CurrentText}" FontSize="11" Foreground="{StaticResource AlertTextBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Close"
                            VerticalAlignment="Top" Command="{Binding CancelCommand}"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="22,18,22,4">
                <TextBlock Text="{Binding Message}" FontSize="13" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding AboveText}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                <TextBlock Text="Switching lowers only the settings above Medium. Your resolution, window mode and keys stay as they are. You can restore your old settings in Settings."
                           FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                <CheckBox Content="Don't warn me again" Margin="0,14,0,0" IsChecked="{Binding DontShowAgain}"/>
            </StackPanel>

            <Border Grid.Row="2" Background="{StaticResource BgBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12" Padding="22,14" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="PLAY ANYWAY" Padding="16,8" Command="{Binding PlayAnywayCommand}"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="SWITCH TO MEDIUM AND PLAY" Padding="20,8" Margin="10,0,0,0"
                            Command="{Binding ApplyMediumCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
