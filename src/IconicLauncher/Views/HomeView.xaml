<UserControl x:Class="IconicLauncher.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,8,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="SERVERS" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh server status"
                            Command="{Binding DataContext.RefreshStatusesCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <TextBlock Text="{Binding DataContext.SyncCountdownText, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Padding="12,6" FontSize="11" ToolTip="Add any DayZ server by IP and port"
                            Command="{Binding DataContext.ShowAddServerCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="ADD SERVER" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Padding="12,6" FontSize="11" Margin="8,0,0,0" ToolTip="Show, hide or delete servers in this list"
                            Command="{Binding DataContext.ShowEditServersCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="EDIT SERVER LIST" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Servers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,8,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{Binding Online, Converter={StaticResource OnlineDotConverter}}"/>
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Margin="10,0,0,0" Foreground="{StaticResource HotBrush}" VerticalAlignment="Center"/>
                                            <Border Style="{StaticResource Badge}" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Text="{Binding ModCount, StringFormat={}{0} MODS}"/>
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Margin="6,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}">
                                                <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource StatusGreenBrush}" Text="YOURS"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="JOIN ANYWAY" Height="30" FontSize="11" Padding="12,0" Margin="0,0,8,0" Command="{Binding JoinAnywayCommand}"
                                                    Visibility="{Binding CanJoinAnyway, Converter={StaticResource BoolToVis}}"/>
                                            <Button Style="{StaticResource PrimaryButton}" MinWidth="130" Height="30" FontSize="11" Padding="14,0"
                                                    Content="{Binding ActionLabel}" Command="{Binding JoinCommand}"/>
                                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                                <Button Style="{StaticResource IconButton}" Content="&#xE70E;" FontSize="9" Width="22" Height="15" Margin="0,0,0,2"
                                                        ToolTip="Move this server up" Command="{Binding MoveUpCommand}"/>
                                                <Button Style="{StaticResource IconButton}" Content="&#xE70D;" FontSize="9" Width="22" Height="15" Margin="0"
                                                        ToolTip="Move this server down" Command="{Binding MoveDownCommand}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,6,0,0">
                                        <TextBlock Text="{Binding PlayersText}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Text="players" Foreground="{StaticResource MutedBrush}" Margin="6,0,18,0"/>
                                        <TextBlock Text="{Binding PingText}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="20,6,0,0"
                                                Visibility="{Binding RestartText, Converter={StaticResource NullToVis}}">
                                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource AlertTextBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"
                                                   Visibility="{Binding IsRestartSoon, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding RestartText}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRestartSoon}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource AlertTextBrush}"/>
                                                            <Setter Property="FontSize" Value="14"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Row="3" Margin="20,10,8,0" CornerRadius="6" BorderThickness="1"
                                            BorderBrush="{StaticResource StatusAmberBrush}" Background="#1FFFB300"
                                            Visibility="{Binding PasswordProtected, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Margin="12,10">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource StatusAmberBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="SERVER UNDER MAINTENANCE" FontWeight="Bold" FontSize="13" Foreground="{StaticResource StatusAmberBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="The server is password protected right now. If you have the maintenance password you can still join."
                                                       FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            <Button Content="ENTER PASSWORD" FontSize="10" Padding="10,5" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                    Command="{Binding TogglePasswordEntryCommand}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                        Visibility="{Binding PasswordEntryOpen, Converter={StaticResource BoolToVis}}">
                                                <PasswordBox Width="200" PasswordChanged="OnServerPasswordChanged" VerticalContentAlignment="Center"
                                                             Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextBrush}"
                                                             BorderBrush="{StaticResource HairlineBrush}" Padding="8,6"/>
                                                <Button Content="APPLY" Margin="8,0,0,0" FontSize="10" Padding="10,5" Command="{Binding ConfirmPasswordCommand}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Grid.Row="4" Margin="20,6,0,0">
                                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                                                   Visibility="{Binding StatusText, Converter={StaticResource NullToVis}}"/>
                                        <ProgressBar Height="8" Margin="0,8,0,0" Maximum="100" Value="{Binding DownloadPercent, Mode=OneWay}"
                                                     Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="16,0,0,0">
            <StackPanel>
                <TextBlock Text="NEWS" Style="{StaticResource SectionLabel}"/>
                <ItemsControl ItemsSource="{Binding News}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Date}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                        <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4" Background="{StaticResource StatusGreenBrush}" VerticalAlignment="Center"
                                                Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#4CAF50" BlurRadius="12" ShadowDepth="0" Opacity="0.85"/>
                                            </Border.Effect>
                                            <TextBlock Text="NEW" FontSize="9" FontWeight="Bold" Foreground="#10130E"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="{Binding Body}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                                    <Button Content="READ MORE" Margin="0,10,0,0" HorizontalAlignment="Left" FontSize="10" Padding="10,5"
                                            Visibility="{Binding Url, Converter={StaticResource NullToVis}}"
                                            Command="{Binding DataContext.OpenNewsLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
