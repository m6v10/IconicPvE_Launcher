<UserControl x:Class="IconicLauncher.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IconicLauncher.Controls">
    <UserControl.Resources>
        <Style x:Key="GhostIcon" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ServerBadges">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource Badge}" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding Region, Converter={StaticResource NullToVis}}">
                    <TextBlock Text="{Binding Region}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                </Border>
                <Border Style="{StaticResource Badge}" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="YOURS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource StatusGreenBrush}"/>
                </Border>
                <Border Style="{StaticResource Badge}" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="{Binding ExperimentalToolTip}"
                        Visibility="{Binding IsExperimental, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="EXPERIMENTAL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource StatusAmberBrush}"/>
                </Border>
                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource StatusAmberBrush}" ToolTip="Password protected right now"
                           Visibility="{Binding PasswordProtected, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="28,20,24,22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button x:Name="ProfileChip" Style="{StaticResource ChipButton}" Padding="6,6,14,6" HorizontalAlignment="Left"
                ToolTip="Open your profile"
                DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                Command="{Binding NavigateCommand}" CommandParameter="PROFILE">
            <StackPanel Orientation="Horizontal">
                <Grid Width="38" Height="38">
                    <Ellipse Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Fill="#990C0E12"/>
                    <TextBlock Text="{Binding Profile.HomeSummary.Badge}" Style="{StaticResource DisplayText}" FontSize="17"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Profile.HomeSummary.Name}" Style="{StaticResource DisplayText}" FontSize="17"/>
                    <TextBlock Text="{Binding Profile.HomeSummary.Line}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
                <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="14,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}"/>
            </StackPanel>
        </Button>

        <Grid Grid.Column="1" Grid.RowSpan="3" Margin="20,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="NEWS" Style="{StaticResource Eyebrow}" Margin="2,10,0,10"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding News}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GlassCard}" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Date}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                        <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4" Background="{StaticResource StatusGreenBrush}" VerticalAlignment="Center"
                                                Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#4CAF50" BlurRadius="12" ShadowDepth="0" Opacity="0.85"/>
                                            </Border.Effect>
                                            <TextBlock Text="NEW" FontSize="9" FontWeight="Bold" Foreground="#10130E"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource DisplayText}" FontSize="16" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Body}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                                    <Button Content="READ MORE" Margin="0,10,0,0" HorizontalAlignment="Left" FontSize="10" Padding="10,5"
                                            Visibility="{Binding Url, Converter={StaticResource NullToVis}}"
                                            Command="{Binding DataContext.OpenNewsLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,20,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="1040"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
            <Border Style="{StaticResource GlassCard}" Padding="14,12" Margin="0,0,0,10" BorderBrush="{StaticResource StatusAmberBrush}"
                    DataContext="{Binding SelectedServer}"
                    Visibility="{Binding PasswordProtected, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource StatusAmberBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="SERVER UNDER MAINTENANCE" Style="{StaticResource DisplayText}" FontSize="16" Foreground="{StaticResource StatusAmberBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="The server is password protected right now. If you have the maintenance password you can still join."
                                   FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding HasSavedPassword, Converter={StaticResource InvBoolToVis}}"/>
                        <TextBlock Text="Your saved password is used automatically when you join."
                                   FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding HasSavedPassword, Converter={StaticResource BoolToVis}}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                    Visibility="{Binding PasswordEntryOpen, Converter={StaticResource BoolToVis}}">
                            <PasswordBox Width="200" PasswordChanged="OnServerPasswordChanged" VerticalContentAlignment="Center"
                                         Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextBrush}"
                                         BorderBrush="{DynamicResource HairlineBrush}" Padding="8,6"/>
                            <Button Content="SAVE" Margin="8,0,0,0" FontSize="10" Padding="10,5" Command="{Binding ConfirmPasswordCommand}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="ENTER PASSWORD" FontSize="10" Padding="10,5" Command="{Binding TogglePasswordEntryCommand}"
                                Visibility="{Binding HasSavedPassword, Converter={StaticResource InvBoolToVis}}"/>
                        <Button Content="CHANGE" FontSize="10" Padding="10,5" Command="{Binding TogglePasswordEntryCommand}"
                                Visibility="{Binding HasSavedPassword, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="FORGET" FontSize="10" Padding="10,5" Margin="8,0,0,0" Command="{Binding ForgetPasswordCommand}"
                                Visibility="{Binding HasSavedPassword, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <ToggleButton x:Name="PickerSlab" Style="{StaticResource PickerSlab}" Height="76"
                                  IsChecked="{Binding IsPickerOpen, Mode=TwoWay}"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=PickerPopup, Converter={StaticResource InverseBool}}">
                        <Grid DataContext="{Binding SelectedServer}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SERVER" Style="{StaticResource Eyebrow}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,2,9,0"
                                             Fill="{Binding Online, Converter={StaticResource OnlineDotConverter}}"/>
                                    <TextBlock Text="{Binding Name, FallbackValue='No server selected'}" Style="{StaticResource DisplayText}" FontSize="24"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ServerBadges}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="18,0,0,0">
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"
                                               MaxWidth="320" ToolTip="{Binding StatusText}"
                                               Visibility="{Binding StatusText, Converter={StaticResource NullToVis}}"/>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding RestartText, Converter={StaticResource NullToVis}, FallbackValue=Collapsed}">
                                        <TextBlock Text="  ·  " FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                   Visibility="{Binding StatusText, Converter={StaticResource NullToVis}}"/>
                                        <TextBlock Text="{Binding RestartText}" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRestartSoon}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource AlertTextBrush}"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,6,0" MinWidth="120">
                                <Grid>
                                    <TextBlock Text="{Binding PlayersText}" Style="{StaticResource DisplayText}" FontSize="22" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding PingText}" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <controls:SegmentBar Height="6" Margin="0,3,0,0" Segments="12" Gap="2"
                                                     Value="{Binding Players}" Maximum="{Binding MaxPlayers}"
                                                     Fill="{DynamicResource AccentBrush}" Track="{StaticResource SegmentTrackBrush}"/>
                                <TextBlock Text="PLAYERS ONLINE" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="10,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                        </Grid>
                    </ToggleButton>
                    <ProgressBar Height="3" VerticalAlignment="Bottom" Margin="12,0,12,1" Maximum="100"
                                 Value="{Binding SelectedServer.DownloadPercent, Mode=OneWay}"
                                 Visibility="{Binding SelectedServer.IsDownloading, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                    <Popup x:Name="PickerPopup" PlacementTarget="{Binding ElementName=PickerSlab}" Placement="Top" VerticalOffset="-10"
                           IsOpen="{Binding IsPickerOpen, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                           Width="{Binding ActualWidth, ElementName=PickerSlab}">
                        <Border Background="{StaticResource GlassStrongBrush}" BorderBrush="{DynamicResource AccentDeepBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="8" Margin="0,0,0,14">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="0" Opacity="0.8"/>
                            </Border.Effect>
                            <StackPanel>
                                <Grid Margin="10,4,4,8">
                                    <TextBlock Text="CHOOSE A SERVER" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource GhostIcon}" Content="&#xE72C;" ToolTip="Refresh server status" HorizontalAlignment="Right"
                                            Width="26" Height="24" FontSize="12"
                                            Command="{Binding DataContext.RefreshStatusesCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </Grid>
                                <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Servers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,2">
                                                    <Button Style="{StaticResource PickerRow}"
                                                            Command="{Binding DataContext.PickServerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="4"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="56"/>
                                                                <ColumnDefinition Width="48"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Rectangle Fill="{DynamicResource AccentBrush}" RadiusX="2" RadiusY="2"
                                                                       Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"/>
                                                            <StackPanel Grid.Column="1" Margin="12,0,10,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,2,8,0"
                                                                             Fill="{Binding Online, Converter={StaticResource OnlineDotConverter}}"/>
                                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource DisplayText}" FontSize="18" VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ServerBadges}"/>
                                                                </StackPanel>
                                                                <StackPanel Orientation="Horizontal" Margin="16,1,0,0">
                                                                    <TextBlock Text="{Binding ActionLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                                                    <TextBlock Text="  ·  " FontSize="10" Foreground="{StaticResource MutedBrush}"
                                                                               Visibility="{Binding RestartText, Converter={StaticResource NullToVis}}"/>
                                                                    <TextBlock Text="{Binding RestartText}" FontSize="10" Foreground="{StaticResource MutedBrush}"
                                                                               Visibility="{Binding RestartText, Converter={StaticResource NullToVis}}"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="96">
                                                                <TextBlock Text="{Binding PlayersText}" Style="{StaticResource DisplayText}" FontSize="15" HorizontalAlignment="Right"/>
                                                                <controls:SegmentBar Height="4" Margin="0,2,0,0" Segments="10" Gap="2"
                                                                                     Value="{Binding Players}" Maximum="{Binding MaxPlayers}"
                                                                                     Fill="{DynamicResource AccentBrush}" Track="{StaticResource SegmentTrackBrush}"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="3" Text="{Binding PingText}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Button>
                                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <Button Style="{StaticResource GhostIcon}" Content="&#xE70E;" FontSize="10" Width="24" Height="16"
                                                                ToolTip="Move up in the list" Command="{Binding MoveUpCommand}"/>
                                                        <Button Style="{StaticResource GhostIcon}" Content="&#xE70D;" FontSize="10" Width="24" Height="16"
                                                                ToolTip="Move down in the list" Command="{Binding MoveDownCommand}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Rectangle Height="1" Fill="{DynamicResource HairlineBrush}" Margin="6,8,6,8"/>
                                <StackPanel Orientation="Horizontal" Margin="4,0,4,2">
                                    <Button Padding="12,6" FontSize="11" ToolTip="Add any DayZ server by IP and port"
                                            Command="{Binding DataContext.ShowAddServerCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="ADD SERVER" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Padding="12,6" FontSize="11" Margin="8,0,0,0" ToolTip="Show, hide or delete servers in this list"
                                            Command="{Binding DataContext.ShowEditServersCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="EDIT SERVER LIST" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <Button Style="{StaticResource PlayButton}" Height="76" MinWidth="250"
                            Content="{Binding SelectedServer.ActionLabel, FallbackValue='JOIN SERVER'}"
                            Command="{Binding SelectedServer.JoinCommand}"/>
                </StackPanel>
            </Grid>
            <Grid Margin="2,8,0,0">
                <TextBlock Text="{Binding DataContext.SyncCountdownText, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontSize="10" Foreground="{StaticResource FaintTextBrush}" VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right" Content="JOIN ANYWAY" FontSize="10" Padding="12,4"
                        ToolTip="Start DayZ and connect without checking the mods"
                        Command="{Binding SelectedServer.JoinAnywayCommand}"
                        Visibility="{Binding SelectedServer.CanJoinAnyway, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
            </Grid>
        </StackPanel>
        </Grid>
    </Grid>
</UserControl>
