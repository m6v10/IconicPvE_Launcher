<UserControl x:Class="IconicLauncher.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:IconicLauncher.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="ModRowTemplate">
            <Border Margin="4,2" CornerRadius="6" Padding="10,7">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                <Setter Property="Background" Value="{StaticResource RowAlertBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource IconButton}" Margin="0" Command="{Binding ToggleFavoriteCommand}"
                            ToolTip="Favorite - keeps this mod at the top of the list">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE734;"/>
                                    <Setter Property="Foreground" Value="{StaticResource StatusGrayBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                            <Setter Property="Text" Value="&#xE735;"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Ellipse Grid.Column="1" Width="10" Height="10" VerticalAlignment="Center" Fill="{Binding State, Converter={StaticResource ModStateBrushConverter}}"/>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,10,0">
                        <ctrl:MarqueeText Text="{Binding Name}" TextElement.FontSize="13" TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource TextBrush}" Height="18"/>
                        <TextBlock Text="{Binding WorkshopId}" FontSize="10" Margin="0,1,0,0" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding IndicatorText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="30" MaxWidth="220"
                               Visibility="{Binding IndicatorText, Converter={StaticResource NullToVis}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource AlertTextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Grid.Column="4" Background="{StaticResource ChipBrush}" CornerRadius="4" Padding="8,3" Margin="0,0,6,0" VerticalAlignment="Center" MinWidth="140">
                        <TextBlock Text="{Binding ClientDateText}" FontSize="11" Foreground="{StaticResource FaintTextBrush}" HorizontalAlignment="Left"/>
                    </Border>
                    <Border Grid.Column="5" Background="{StaticResource ChipBrush}" CornerRadius="4" Padding="8,3" Margin="0,0,6,0" VerticalAlignment="Center" MinWidth="150">
                        <TextBlock Text="{Binding WorkshopDateText}" FontSize="11" Foreground="{StaticResource FaintTextBrush}" HorizontalAlignment="Left"/>
                    </Border>
                    <TextBlock Grid.Column="6" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"
                               Foreground="{StaticResource StatusGreenBrush}"
                               Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Content="&#xE838;" Command="{Binding OpenFolderCommand}"
                                ToolTip="Open the mod folder in Explorer"/>
                        <Button Command="{Binding UpdateModCommand}" ToolTip="Check workshop and update this mod">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Outdated">
                                            <Setter Property="Foreground" Value="{StaticResource StatusGreenBrush}"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#4CAF50" BlurRadius="10" ShadowDepth="0" Opacity="0.85"/>
                                                </Setter.Value>
                                            </Setter>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="BlinkOutdated">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.55" Duration="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="BlinkOutdated"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="NotInstalled">
                                            <Setter Property="Foreground" Value="{StaticResource StatusGreenBrush}"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#4CAF50" BlurRadius="10" ShadowDepth="0" Opacity="0.85"/>
                                                </Setter.Value>
                                            </Setter>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="BlinkNotInstalled">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.55" Duration="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="BlinkNotInstalled"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="&#xE896;"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding RebuildCommand}"
                                ToolTip="Delete local files and reinstall fresh from workshop">
                            <TextBlock Text="&#xE72C;">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDamaged}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource StatusAmberBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Command="{Binding DeleteCommand}"
                                ToolTip="Delete mod files and unsubscribe"/>
                    </StackPanel>
                </Grid>
                <ProgressBar Height="4" Margin="60,5,4,1" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding HeaderText}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <Grid>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="12"/>
                <TextBlock Text="Search mods..." IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" FontSize="12"
                           Visibility="{Binding SearchText, Converter={StaticResource EmptyToVis}}"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                           Visibility="{Binding StatusText, Converter={StaticResource NullToVis}}"/>
                <Button Content="FORCE CLOSE DAYZ" FontSize="10" Padding="10,5" Margin="12,0,0,0"
                        Command="{Binding ForceCloseDayZCommand}"
                        Visibility="{Binding DayZBlocked, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
            <ProgressBar Height="8" Margin="0,6,0,0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                         Visibility="{Binding IsUpdatingAll, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
        <Border Grid.Row="2" Margin="0,12,0,0" Background="{StaticResource SurfaceBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                <StackPanel>
                    <TextBlock Text="{Binding NeedsUpdateHeader}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AlertTextBrush}" Margin="8,8,8,4"
                               Visibility="{Binding HasNeedsUpdate, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding NeedsUpdateRows}" ItemTemplate="{StaticResource ModRowTemplate}"/>
                    <TextBlock Text="{Binding UpToDateHeader}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="8,8,8,4"/>
                    <ItemsControl ItemsSource="{Binding UpToDateRows}" ItemTemplate="{StaticResource ModRowTemplate}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="UPDATE ALL MISSING / OUTDATED" Style="{StaticResource PrimaryButton}" Command="{Binding UpdateAllCommand}"/>
            <Button Content="RE-CHECK" Margin="12,0,0,0" Command="{Binding RecheckCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
