<UserControl x:Class="IconicLauncher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="LAUNCHER" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="OPENS WITH" Style="{StaticResource SectionLabel}" Margin="0,6,0,6"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Last used game" GroupName="DefaultGame"
                             IsChecked="{Binding DefaultGame, Converter={StaticResource StringEquals}, ConverterParameter=last, Mode=OneWay}"
                             Command="{Binding SetDefaultGameCommand}" CommandParameter="last"/>
                <RadioButton Content="DayZ" GroupName="DefaultGame" Margin="18,0,0,0"
                             IsChecked="{Binding DefaultGame, Converter={StaticResource StringEquals}, ConverterParameter=dayz, Mode=OneWay}"
                             Command="{Binding SetDefaultGameCommand}" CommandParameter="dayz"/>
                <RadioButton Content="WoW" GroupName="DefaultGame" Margin="18,0,0,0"
                             IsChecked="{Binding DefaultGame, Converter={StaticResource StringEquals}, ConverterParameter=wow, Mode=OneWay}"
                             Command="{Binding SetDefaultGameCommand}" CommandParameter="wow"/>
            </StackPanel>
            <CheckBox Content="Close the launcher after a game starts (DayZ and WoW)" Margin="0,14,0,0" IsChecked="{Binding CloseOnLaunch}"/>

            <StackPanel Visibility="{Binding DataContext.IsDayZActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="DAYZ" Style="{StaticResource SectionLabel}" Margin="0,26,0,6" Foreground="{DynamicResource AccentBrush}"/>
            <CheckBox Content="Discord Rich Presence (shows your DayZ server in Discord)" Margin="0,6,0,0" IsChecked="{Binding DiscordRpcEnabled}"/>
            <CheckBox Content="Update outdated mods automatically in the background (while DayZ is closed)" Margin="0,10,0,0" IsChecked="{Binding AutoUpdateMods}"/>
            <TextBlock Text="GRAPHICS" Style="{StaticResource SectionLabel}" Margin="0,18,0,6"/>
            <Border BorderBrush="{StaticResource StatusAmberBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10"
                    Background="{StaticResource RowAlertBrush}"
                    Visibility="{Binding AdvisoryEnabled, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding AdvisoryTitle}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource AlertTextBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding AdvisoryMessage}" FontSize="12" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding GraphicsStatusText}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource StatusGreenBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding GraphicsRisky}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AlertTextBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding GraphicsAvailable}" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource StatusGrayBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding GraphicsAboveText}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}"
                       Visibility="{Binding GraphicsAboveText, Converter={StaticResource NullToVis}}"/>
            <StackPanel IsEnabled="{Binding GraphicsAvailable}">
                <TextBlock Text="QUALITY PRESET (SAME AS IN-GAME OVERALL QUALITY)" Style="{StaticResource SectionLabel}" Margin="0,12,0,6"/>
                <WrapPanel>
                    <RadioButton Content="Poor" GroupName="GfxPreset" Margin="0,0,18,6"
                                 IsChecked="{Binding GraphicsPreset, Converter={StaticResource StringEquals}, ConverterParameter=poor, Mode=OneWay}"
                                 Command="{Binding SetGraphicsPresetCommand}" CommandParameter="poor"/>
                    <RadioButton Content="Low" GroupName="GfxPreset" Margin="0,0,18,6"
                                 IsChecked="{Binding GraphicsPreset, Converter={StaticResource StringEquals}, ConverterParameter=low, Mode=OneWay}"
                                 Command="{Binding SetGraphicsPresetCommand}" CommandParameter="low"/>
                    <RadioButton Content="Medium (recommended)" GroupName="GfxPreset" Margin="0,0,18,6"
                                 IsChecked="{Binding GraphicsPreset, Converter={StaticResource StringEquals}, ConverterParameter=medium, Mode=OneWay}"
                                 Command="{Binding SetGraphicsPresetCommand}" CommandParameter="medium"/>
                    <RadioButton Content="High" GroupName="GfxPreset" Margin="0,0,18,6"
                                 IsChecked="{Binding GraphicsPreset, Converter={StaticResource StringEquals}, ConverterParameter=high, Mode=OneWay}"
                                 Command="{Binding SetGraphicsPresetCommand}" CommandParameter="high"/>
                    <RadioButton Content="Extreme" GroupName="GfxPreset" Margin="0,0,18,6"
                                 IsChecked="{Binding GraphicsPreset, Converter={StaticResource StringEquals}, ConverterParameter=extreme, Mode=OneWay}"
                                 Command="{Binding SetGraphicsPresetCommand}" CommandParameter="extreme"/>
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="LOWER ONLY WHAT IS ABOVE MEDIUM" MinWidth="200" FontSize="10" Padding="10,5" Command="{Binding CapGraphicsAtMediumCommand}"
                            Visibility="{Binding GraphicsRisky, Converter={StaticResource BoolToVis}}" Margin="0,0,10,0"/>
                    <Button Content="RESTORE MY OLD SETTINGS" MinWidth="160" FontSize="10" Padding="10,5" Command="{Binding RestoreGraphicsCommand}"
                            Visibility="{Binding HasGraphicsBackup, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Text="DISPLAY MODE" Style="{StaticResource SectionLabel}" Margin="0,14,0,6"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Fullscreen" GroupName="DisplayMode"
                             IsChecked="{Binding DisplayMode, Converter={StaticResource StringEquals}, ConverterParameter=fullscreen, Mode=OneWay}"
                             Command="{Binding SetDisplayModeCommand}" CommandParameter="fullscreen"/>
                <RadioButton Content="Windowed" GroupName="DisplayMode" Margin="18,0,0,0"
                             IsChecked="{Binding DisplayMode, Converter={StaticResource StringEquals}, ConverterParameter=windowed, Mode=OneWay}"
                             Command="{Binding SetDisplayModeCommand}" CommandParameter="windowed"/>
            </StackPanel>
            <TextBlock Text="{Binding GraphicsSaveStatus}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource StatusGreenBrush}"
                       Visibility="{Binding GraphicsSaveStatus, Converter={StaticResource NullToVis}}"/>
            <TextBlock Text="These change the same files as DayZ's own video options. DayZ must be closed. The launcher keeps a copy of your old settings the first time it changes them."
                       FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource StatusGrayBrush}"/>
            <TextBlock Text="PROFILE NAME" Style="{StaticResource SectionLabel}" Margin="0,14,0,6"/>
            <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProfileNameSuspicious}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource StatusRedBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
            <TextBlock Text="The server will not accept 'Survivor' as a name - you will be switched to your Steam name when joining. Set a proper in-game name."
                       FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource AlertTextBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProfileNameSurvivor}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="SurvivorWarningPulse">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.35"
                                                             Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="SurvivorWarningPulse"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding DuplicateSuffixHintText}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource AlertTextBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDuplicateSuffix}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="DuplicateWarningPulse">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.35"
                                                             Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="DuplicateWarningPulse"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="LAUNCH OPTIONS" Style="{StaticResource SectionLabel}" Margin="0,18,0,6"/>
            <CheckBox Content="No splash screen (-noSplash)" IsChecked="{Binding LaunchNoSplash}"/>
            <CheckBox Content="Keep running when tabbed out (-noPause)" Margin="0,10,0,0" IsChecked="{Binding LaunchNoPause}"/>
            <CheckBox Content="Extended game logs (-doLogs)" Margin="0,10,0,0" IsChecked="{Binding LaunchDoLogs}"/>
            <CheckBox Content="Auto-connect to the server on launch" Margin="0,10,0,0" IsChecked="{Binding AutoConnect}"/>
            <TextBlock Text="EXTRA LAUNCH PARAMETERS (APPENDED ON TOP OF THE OPTIONS ABOVE)" Style="{StaticResource SectionLabel}" Margin="0,18,0,6"/>
            <TextBox Text="{Binding ExtraLaunchParams, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="DAYZ PATH OVERRIDE" Style="{StaticResource SectionLabel}" Margin="0,18,0,6"/>
            <Grid>
                <TextBox Text="{Binding DayZPathOverride, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{Binding AutoDetectedDayZPath}" Margin="10,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{StaticResource StatusGrayBrush}" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding DayZPathOverride, Converter={StaticResource EmptyToVis}}"/>
            </Grid>
            <TextBlock Text="DAYZ EXPERIMENTAL PATH OVERRIDE" Style="{StaticResource SectionLabel}" Margin="0,18,0,6"/>
            <Grid>
                <TextBox Text="{Binding DayZExpPathOverride, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{Binding AutoDetectedDayZExpPath}" Margin="10,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{StaticResource StatusGrayBrush}" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding DayZExpPathOverride, Converter={StaticResource EmptyToVis}}"/>
            </Grid>
            <TextBlock Text="Servers running the experimental version are joined with DayZ Exp automatically. Both games use the same Workshop mods, so nothing downloads twice. Force it per server in EDIT SERVER LIST."
                       FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource StatusGrayBrush}"/>
            <TextBlock Text="{Binding GameVersionsText}" FontSize="12" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}"
                       Visibility="{Binding GameVersionsText, Converter={StaticResource NullToVis}}"/>
            <TextBlock Text="STEAM PATH OVERRIDE" Style="{StaticResource SectionLabel}" Margin="0,18,0,6"/>
            <Grid>
                <TextBox Text="{Binding SteamPathOverride, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{Binding AutoDetectedSteamPath}" Margin="10,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{StaticResource StatusGrayBrush}" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding SteamPathOverride, Converter={StaticResource EmptyToVis}}"/>
            </Grid>
            </StackPanel>

            <StackPanel Visibility="{Binding DataContext.IsWowActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="WOW" Style="{StaticResource SectionLabel}" Margin="0,26,0,6" Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="GAME FOLDER" Style="{StaticResource SectionLabel}" Margin="0,6,0,6"/>
            <TextBox Text="{Binding WowClientPath, UpdateSourceTrigger=PropertyChanged}"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="SEARCH THIS PC" MinWidth="140" FontSize="10" Padding="10,5" Command="{Binding DetectWowCommand}"/>
                <TextBlock Text="{Binding WowDetectStatus}" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"
                           Foreground="{StaticResource StatusGreenBrush}" TextTrimming="CharacterEllipsis" MaxWidth="380"/>
            </StackPanel>
            <TextBlock Text="The folder that contains Wow.exe."
                       FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource StatusGrayBrush}"/>
            </StackPanel>

            <TextBlock Text="TROUBLESHOOTING" Style="{StaticResource SectionLabel}" Margin="0,26,0,6" Foreground="{DynamicResource AccentBrush}"/>
            <CheckBox Content="Debug mode (verbose logging of mod checks, downloads and connections)" IsChecked="{Binding DebugLogging}"/>
            <TextBlock Text="Only leave this ticked while reproducing a problem. Leaving it on all the time bloats the log files on your disk and can cause lags while playing."
                       FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource AlertTextBrush}"
                       Visibility="{Binding DebugLogging, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="Turn this on, reproduce your problem (e.g. press the download button that does nothing), then use the buttons below."
                       FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource StatusGrayBrush}"/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="DUMP LOGS TO DESKTOP" MinWidth="200" Command="{Binding DumpLogsCommand}"/>
                <TextBlock Text="{Binding DumpStatus}" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource StatusGreenBrush}" TextWrapping="Wrap" MaxWidth="360"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="SEND LOGS TO DEVELOPER" MinWidth="200" Command="{Binding SendLogsCommand}"/>
                <TextBlock Text="{Binding SendStatus}" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource StatusGreenBrush}" TextWrapping="Wrap" MaxWidth="360"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <Button Content="SAVE" Style="{StaticResource PrimaryButton}" MinWidth="140" Command="{Binding SaveCommand}"/>
                <TextBlock Text="{Binding SaveStatus}" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource StatusGreenBrush}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
