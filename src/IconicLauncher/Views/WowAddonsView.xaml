<UserControl x:Class="IconicLauncher.Views.WowAddonsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="OPTIONAL ADD-ONS" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Check the addon list again" Command="{Binding RefreshCommand}"/>
                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"
                           Visibility="{Binding StatusText, Converter={StaticResource NullToVis}}"/>
            </StackPanel>
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource StatusAmberBrush}"
                       Text="Fully restart the game client to load newly installed addons - /reload is not enough"
                       Visibility="{Binding ShowRestartHint, Converter={StaticResource BoolToVis}}"/>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource StatusRedBrush}" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"
                           Visibility="{Binding ErrorText, Converter={StaticResource NullToVis}}"/>
                <ItemsControl ItemsSource="{Binding Addons}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,8,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="72" Height="72" CornerRadius="8" Background="{StaticResource Surface2Brush}" ClipToBounds="True" VerticalAlignment="Center">
                                        <Grid>
                                            <TextBlock Text="{Binding InitialLetter}" FontSize="30" FontWeight="Black" Foreground="{StaticResource MutedBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding HasImage, Converter={StaticResource InvBoolToVis}}"/>
                                            <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource HotBrush}"/>
                                            <Border Style="{StaticResource Badge}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="INSTALLED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource StatusGreenBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        <ProgressBar Height="6" Margin="0,8,0,0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Button Style="{StaticResource PrimaryButton}" MinWidth="110" Height="30" FontSize="11" Padding="14,0"
                                                Content="{Binding ActionLabel}" Command="{Binding InstallCommand}"/>
                                        <TextBlock Text="{Binding StateText}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"
                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
