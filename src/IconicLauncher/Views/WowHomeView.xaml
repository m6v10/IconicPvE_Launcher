<UserControl x:Class="IconicLauncher.Views.WowHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>
            <Grid Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{Binding Online, Converter={StaticResource OnlineDotConverter}}"/>
                            <TextBlock Text="{Binding RealmName}" FontSize="17" FontWeight="Bold" Margin="10,0,0,0" Foreground="#69CCF0" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource Badge}" Margin="10,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding ClientVersionText, Converter={StaticResource NullToVis}}">
                                <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Text="{Binding ClientVersionText}"/>
                            </Border>
                            <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding PlayersText}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="Players Online" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="6,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding BotsText}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="Player Bots Online" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="6,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="GET FULL CLIENT" FontSize="10" Padding="10,5" Margin="0,0,8,0"
                                    Visibility="{Binding FullClientUrl, Converter={StaticResource NullToVis}}"
                                    Command="{Binding OpenFullClientCommand}"/>
                            <Button Content="DETECT" FontSize="10" Padding="10,5" Margin="0,0,8,0"
                                    ToolTip="Search this PC for a WoW 3.3.5a installation"
                                    Command="{Binding DetectManuallyCommand}"/>
                            <Button Content="GAME FOLDER" FontSize="10" Padding="10,5" ToolTip="{Binding ClientPathText}"
                                    Command="{Binding BrowseCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Image Source="/Assets/wow_hero.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <MediaElement x:Name="HeroVideo" Source="{Binding HeroVideoUri}" Stretch="UniformToFill"
                                      LoadedBehavior="Manual" UnloadedBehavior="Close" IsMuted="True"
                                      Loaded="OnHeroVideoLoaded" MediaOpened="OnHeroVideoLoaded"
                                      MediaEnded="OnHeroVideoEnded" MediaFailed="OnHeroVideoFailed"
                                      Visibility="{Binding HeroVideoUri, Converter={StaticResource NullToVis}}"/>
                        <TextBlock Text="{Binding StatusDetailText}" Foreground="{StaticResource StatusAmberBrush}" FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14" TextWrapping="Wrap"
                                   Visibility="{Binding StatusDetailText, Converter={StaticResource NullToVis}}"/>
                        <Border Background="#C0070809" Visibility="{Binding IsConfigured, Converter={StaticResource InvBoolToVis}}">
                            <TextBlock Text="The WoW realm is not configured in the launcher yet."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="16,0,0,0">
                <StackPanel>
                    <TextBlock Text="NEWS" Style="{StaticResource SectionLabel}"/>
                    <ItemsControl ItemsSource="{Binding News}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Date}" FontSize="10" FontWeight="Bold" Foreground="#69CCF0"/>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="{Binding Body}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                                        <Button Content="READ MORE" Margin="0,10,0,0" HorizontalAlignment="Left" FontSize="10" Padding="10,5"
                                                Visibility="{Binding Url, Converter={StaticResource NullToVis}}"
                                                Command="{Binding DataContext.OpenNewsLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource StatusRedBrush}" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"
                       Visibility="{Binding ErrorText, Converter={StaticResource NullToVis}}"/>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <ProgressBar Height="36" Maximum="100" Value="{Binding ApplyPercent, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsVerifying}"/>
                    <TextBlock Text="{Binding BarText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0"/>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="&#xE711;" Style="{StaticResource IconButton}" Width="36" Height="36" FontSize="14" Margin="8,0,0,0"
                            ToolTip="Cancel the download" Command="{Binding CancelDownloadCommand}"
                            Visibility="{Binding IsApplying, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="&#xE72C;" Style="{StaticResource IconButton}" Width="36" Height="36" FontSize="14" Margin="8,0,0,0"
                            ToolTip="Check the game files again" Command="{Binding RefreshCommand}"/>
                    <Button Content="&#xE90F;" Style="{StaticResource IconButton}" Width="36" Height="36" FontSize="14" Margin="4,0,0,0"
                            ToolTip="Repair: re-download every managed file" Command="{Binding RepairCommand}"/>
                    <Button Style="{StaticResource PrimaryButton}" MinWidth="180" Height="36" FontSize="13" Padding="20,0" Margin="12,0,0,0"
                            Content="{Binding ActionLabel}" Command="{Binding PrimaryActionCommand}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
